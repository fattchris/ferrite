# Ferrite Production Environment (P-3 fix)
#
# Copy to .env and fill in real values.
# .env is in .gitignore — never commit secrets.
#
# Generate strong secrets with:
#   openssl rand -hex 32

# Neo4j password (MUST be changed from default)
NEO4J_PASSWORD=change-me-to-a-strong-password

# Ferrite API key (Bearer token for auth)
FERRITE_API_KEY=change-me-to-a-strong-api-key

# LLM API key (for LiteLLM/OpenRouter)
LLM_API_KEY=

# Domain for Caddy TLS (real domain for auto-HTTPS, or localhost)
FERRITE_DOMAIN=localhost
