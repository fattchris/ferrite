{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "ferrite": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--project",
        "${PLUGIN_ROOT}",
        "python",
        "-m",
        "ferrite.mcp_server"
      ],
      "env": {
        "FERRITE_API_KEY": "${FERRITE_API_KEY}"
      }
    },
    "ferrite-http": {
      "type": "http",
      "url": "http://localhost:8002/mcp/",
      "headers": {
        "Authorization": "Bearer ${FERRITE_API_KEY}"
      }
    }
  }
}
