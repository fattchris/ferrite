# SSSF environment for Hermes. Copy to .env at the target repo root.
#
# TWO API endpoints:
#   OpenRouter — cloud models (GPT-5.6 Luna, GLM-5.2, Grok 4.5)
#   LiteLLM    — local proxy at localhost:4000 (DeepSeek V4, Qwen, Laguna)
#
# The starter roster uses LiteLLM for builder/scout/documenter and
# OpenRouter for planner/reviewer, so you need both keys.

OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE

LITELLM_API_KEY=sk-litellm-YOUR_KEY_HERE
LITELLM_BASE_URL=http://localhost:4000/v1

# Optional overrides
# CLAUDE_PATH=claude
# CODEX_PATH=codex
